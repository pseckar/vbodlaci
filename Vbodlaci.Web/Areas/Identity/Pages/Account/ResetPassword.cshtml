@page
@model Vbodlaci.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Nastavení nového hesla";
}

<section class="section admin-section">
    <div class="wrap">
        <div class="auth-card">
            <h1>Nastavení nového hesla</h1>
            <p class="muted">Zadej e-mail svého účtu a zvol si nové heslo.</p>

            <form method="post" class="form-grid">
                <div asp-validation-summary="ModelOnly" class="field-error"></div>
                <input asp-for="Input.Code" type="hidden" />

                <label asp-for="Input.Email">E-mail</label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="field-error"></span>

                <label asp-for="Input.Password">Nové heslo</label>
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="field-error"></span>

                <label asp-for="Input.ConfirmPassword">Potvrzení hesla</label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

                <button type="submit" class="btn btn-moss">Nastavit heslo</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

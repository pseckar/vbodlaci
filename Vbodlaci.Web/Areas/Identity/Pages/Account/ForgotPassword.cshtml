@page
@model Vbodlaci.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Obnova hesla";
}

<section class="section admin-section">
    <div class="wrap">
        <div class="auth-card">
            <h1>Obnova hesla</h1>
            <p class="muted">Zadej e-mail svého administrátorského účtu. Pošleme ti odkaz pro nastavení nového hesla.</p>

            <form method="post" class="form-grid">
                <div asp-validation-summary="ModelOnly" class="field-error"></div>

                <label asp-for="Input.Email">E-mail</label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="field-error"></span>

                <button type="submit" class="btn btn-moss">Poslat odkaz</button>
            </form>

            <p class="auth-links"><a asp-page="./Login">Zpět na přihlášení</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

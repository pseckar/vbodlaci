@page
@{
    ViewData["Title"] = "Obnova hesla";
}

<section class="section admin-section">
    <div class="wrap">
        <div class="auth-card">
            <h1>Zkontroluj e-mail</h1>
            <p class="muted">Pokud účet existuje, poslali jsme ti e-mail s odkazem pro nastavení nového hesla.</p>
            <p class="auth-links"><a asp-page="./Login">Zpět na přihlášení</a></p>
        </div>
    </div>
</section>

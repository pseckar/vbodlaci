@page
@model Vbodlaci.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Přihlášení";
}

<section class="section admin-section">
    <div class="wrap">
        <div class="auth-card">
            <h1>Přihlášení</h1>
            <p class="muted">Administrátorská zóna webu V bodláčí.</p>

            <form method="post" class="form-grid">
                <div asp-validation-summary="ModelOnly" class="field-error"></div>

                <label asp-for="Input.Email">E-mail</label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="field-error"></span>

                <label asp-for="Input.Password">Heslo</label>
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="field-error"></span>

                <label class="checkbox-row"><input asp-for="Input.RememberMe" /> Zapamatovat si mě</label>

                <button id="login-submit" type="submit" class="btn btn-moss">Přihlásit se</button>
            </form>

            <p class="auth-links"><a asp-page="./ForgotPassword">Zapomenuté heslo?</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

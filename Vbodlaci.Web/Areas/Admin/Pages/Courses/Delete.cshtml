@page "/admin/courses/smazat/{id:guid}"
@model Vbodlaci.Web.Areas.Admin.Pages.Courses.DeleteModel
@{
    ViewData["Title"] = "Smazat kurz";
}

<section class="hero-card">
    <h1>Smazat kurz</h1>
    <p>Akci není možné vrátit. Před smazáním zkontroluj název kurzu.</p>
</section>

@if (Model.Course is null)
{
    <section class="warning-card">
        <p>Kurz nebyl nalezen.</p>
        <a class="button button-secondary" asp-page="/Courses/Index" asp-area="Admin">Zpět na přehled</a>
    </section>
}
else
{
    <section class="warning-card">
        <h2>@Model.Course.Title</h2>
        <p>@Model.Course.ShortDescription</p>
        <p class="small-text">Termín: @Model.Course.StartDate.ToString("dd.MM.yyyy"), kapacita: @Model.Course.Capacity</p>
        <form method="post" class="cta-row">
            <button type="submit" class="button button-danger">Ano, smazat</button>
            <a class="button button-secondary" asp-page="/Courses/Index" asp-area="Admin">Zrušit</a>
        </form>
    </section>
}

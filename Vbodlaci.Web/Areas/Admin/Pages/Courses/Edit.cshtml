@page "{id:guid}"
@using Vbodlaci.Web.Domain.Courses
@model Vbodlaci.Web.Areas.Admin.Pages.Courses.EditModel
@{
    ViewData["Title"] = "Úprava kurzu";
}

<section class="section">
    <h1>Úprava kurzu</h1>
    <a class="button button-secondary" asp-page="/Courses/Index">← Zpět na přehled</a>

    <form method="post" asp-area="Admin" asp-page="/Courses/Edit" asp-route-id="@Model.CourseId" class="form-grid" onsubmit="return confirmPublish(this);">
        <partial name="_CourseFormFields" model="Model.Input" />
        <button type="submit" class="button button-primary">Uložit kurz</button>
    </form>

    <div class="section">
        <h2>Rychlá změna stavu</h2>
        <div class="inline-actions">
            <form method="post" asp-page-handler="Status" onsubmit="return confirm('Při publikaci se mohou odeslat newsletter e-maily. Pokračovat?');">
                <input type="hidden" name="id" value="@Model.CourseId" />
                <input type="hidden" name="status" value="Published" />
                <button class="button button-primary" type="submit">Publikovat</button>
            </form>
            <form method="post" asp-page-handler="Status">
                <input type="hidden" name="id" value="@Model.CourseId" />
                <input type="hidden" name="status" value="Draft" />
                <button class="button button-secondary" type="submit">Přesunout do draftu</button>
            </form>
            <form method="post" asp-page-handler="Status" onsubmit="return confirm('Opravdu chceš kurz zrušit?');">
                <input type="hidden" name="id" value="@Model.CourseId" />
                <input type="hidden" name="status" value="Canceled" />
                <button class="button button-secondary" type="submit">Označit jako zrušený</button>
            </form>
        </div>
    </div>

    <div class="section">
        <h2>Pomocný text pro Facebook</h2>
        <textarea readonly>@Model.FacebookPostText</textarea>
        <p class="muted">Text můžeš zkopírovat do Facebook příspěvku po publikaci nebo úpravě kurzu.</p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmPublish(form) {
            const statusField = form.querySelector('[name="Input.Status"]');
            if (!statusField) return true;
            if (statusField.value !== 'Published') return true;
            return confirm('Při uložení publikovaného kurzu může dojít k rozeslání newsletteru. Pokračovat?');
        }
    </script>
}

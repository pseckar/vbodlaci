@page
@using Vbodlaci.Web.Domain.Courses
@model Vbodlaci.Web.Areas.Admin.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "Nový kurz";
}

<section class="section">
    <h1>Nový kurz</h1>
    <a class="button button-secondary" asp-page="/Courses/Index">← Zpět na přehled</a>
    <form method="post" asp-area="Admin" asp-page="/Courses/Create" class="form-grid">
        <partial name="_CourseFormFields" model="Model.Input" />
        <button type="submit" class="button button-primary">Vytvořit kurz</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

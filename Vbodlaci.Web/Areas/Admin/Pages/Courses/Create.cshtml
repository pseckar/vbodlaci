@page
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Vbodlaci.Web.Domain.Courses
@model Vbodlaci.Web.Areas.Admin.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "Nový kurz";
    var formViewData = new ViewDataDictionary(ViewData)
    {
        ["AllowDefaultEditing"] = true
    };
    var defaultsJson = JsonSerializer.Serialize(Model.DefaultTexts.Select(item => new
    {
        type = item.Type.ToString(),
        field = item.Field.ToString(),
        text = item.Text
    }));
}

<a class="btn btn-outline page-back-link"
   asp-page="/Courses/Index"
   data-confirm-dirty
   data-dirty-form-id="course-create-form"
   data-confirm-message="Máš neuložené změny. Opravdu se chceš vrátit na přehled?">← Zpět na přehled</a>

<section class="section admin-section">
    <div class="wrap">
        <h1>Nový kurz</h1>

        <p class="muted">Kurz se uloží jako návrh. Publikovat ho můžeš v dalším kroku, kde uvidíš i náhled.</p>

        <form method="post" enctype="multipart/form-data" asp-area="Admin" asp-page="/Courses/Create" class="form-grid admin-form" id="course-create-form" data-dirty-form>
            <partial name="_CourseFormFields" model="Model.Input" view-data="formViewData" />

            <div class="inline-actions">
                <button type="submit" class="btn btn-gold">Pokračovat</button>
            </div>
        </form>
    </div>
</section>

<div class="modal fade" id="defaultTextModal" tabindex="-1" aria-labelledby="defaultTextModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-area="Admin" asp-page="/Courses/Create" asp-page-handler="DefaultText">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="defaultTextModalLabel">Upravit výchozí text</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="DefaultType" id="defaultTextType" />
                    <input type="hidden" asp-for="DefaultField" id="defaultTextField" />
                    <label for="defaultTextValue">Výchozí text</label>
                    <textarea asp-for="DefaultText" id="defaultTextValue" rows="8"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Zrušit</button>
                    <button type="submit" class="btn btn-gold">Uložit výchozí text</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="application/json" id="courseDefaultsJson">@Html.Raw(defaultsJson)</script>
}

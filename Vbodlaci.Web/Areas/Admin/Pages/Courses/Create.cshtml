@page
@using Vbodlaci.Web.Domain.Courses
@model Vbodlaci.Web.Areas.Admin.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "Nový kurz";
}

<a class="button button-secondary page-back-link"
   asp-page="/Courses/Index"
   data-confirm-dirty
   data-dirty-form-id="course-create-form"
   data-confirm-message="Máš neuložené změny. Opravdu se chceš vrátit na přehled?">← Zpět na přehled</a>

<section class="section">
    <h1>Nový kurz</h1>

    <form method="post" asp-area="Admin" asp-page="/Courses/Create" class="form-grid" id="course-create-form" data-dirty-form>
        <partial name="_CourseFormFields" model="Model.Input" />

        <div class="inline-actions">
            <button type="submit" asp-page-handler="Publish" class="button button-primary" onclick="return confirm('Kurz bude publikovaný a newsletter odběratelé mohou dostat e-mail. Pokračovat?');">Publikovat</button>
            <button type="submit" asp-page-handler="Draft" class="button button-secondary">Uložit jako draft</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

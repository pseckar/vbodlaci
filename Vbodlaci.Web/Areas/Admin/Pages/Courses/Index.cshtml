@page
@using Vbodlaci.Web.Domain.Courses
@model Vbodlaci.Web.Areas.Admin.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Správa kurzů";
}

<a class="btn btn-outline page-back-link" asp-page="/Index">← Zpět do administrace</a>

<section class="section admin-section">
    <div class="wrap">
        <div class="admin-head">
            <h1>Kurzy</h1>
            <a class="btn btn-gold" asp-page="/Courses/Create">+ Nový kurz</a>
        </div>

        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>Název</th>
                    <th>Typ</th>
                    <th>Stav</th>
                    <th>Termín</th>
                    <th>Místo</th>
                    <th>Akce</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr>
                        <td><a asp-page="/Courses/Edit" asp-route-id="@course.Id">@course.Title</a></td>
                        <td>@(course.Type == CourseType.Breathwork ? "Breathwork" : "Koně")</td>
                        <td>
                            <span class="status-badge status-@course.Status.ToString().ToLowerInvariant()">
                                @(course.Status switch { CourseStatus.Draft => "Draft", CourseStatus.Published => "Publikovaný", CourseStatus.Canceled => "Zrušen", _ => course.Status.ToString() })
                            </span>
                        </td>
                        <td>@course.CourseDate.ToString("dd.MM.yyyy") @course.TimeText</td>
                        <td>@course.CityOrArea</td>
                        <td>
                            <div class="inline-actions">
                                <a class="btn btn-outline" asp-page="/Courses/Edit" asp-route-id="@course.Id">Upravit</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

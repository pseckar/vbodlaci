@page
@using Vbodlaci.Web.Domain.Courses
@model Vbodlaci.Web.Areas.Admin.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Správa kurzů";
}

<section class="section">
    <h1>Kurzy</h1>
    <a class="button button-primary" asp-page="/Courses/Create">+ Nový kurz</a>

    <div class="table-wrap">
        <table class="admin-table">
            <thead>
            <tr>
                <th>Název</th>
                <th>Typ</th>
                <th>Stav</th>
                <th>Termín</th>
                <th>Místo</th>
                <th>Akce</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var course in Model.Courses)
            {
                <tr>
                    <td><a asp-page="/Courses/Edit" asp-route-id="@course.Id">@course.Title</a></td>
                    <td>@(course.Type == CourseType.Breathwork ? "Breathwork" : "Koně")</td>
                    <td>@course.Status</td>
                    <td>@course.StartDateTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@course.CityOrArea</td>
                    <td>
                        <div class="inline-actions">
                            <a class="button button-secondary" asp-page="/Courses/Edit" asp-route-id="@course.Id">Upravit</a>
                            <form method="post" asp-page-handler="Status" onsubmit="return confirm('Opravdu chceš kurz publikovat? Při první publikaci se odešle newsletter.');">
                                <input type="hidden" name="id" value="@course.Id" />
                                <input type="hidden" name="status" value="Published" />
                                <button type="submit" class="button button-primary">Publikovat</button>
                            </form>
                            <form method="post" asp-page-handler="Status">
                                <input type="hidden" name="id" value="@course.Id" />
                                <input type="hidden" name="status" value="Draft" />
                                <button type="submit" class="button button-secondary">Do konceptu</button>
                            </form>
                            <form method="post" asp-page-handler="Status" onsubmit="return confirm('Opravdu chceš kurz označit jako zrušený?');">
                                <input type="hidden" name="id" value="@course.Id" />
                                <input type="hidden" name="status" value="Canceled" />
                                <button type="submit" class="button button-secondary">Zrušit</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Opravdu chceš kurz odstranit?');">
                                <input type="hidden" name="id" value="@course.Id" />
                                <button type="submit" class="button button-secondary">Smazat</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

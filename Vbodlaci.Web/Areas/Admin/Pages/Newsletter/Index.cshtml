@page
@model Vbodlaci.Web.Areas.Admin.Pages.Newsletter.IndexModel
@{
    ViewData["Title"] = "Newsletter odběratelé";
}

<a class="btn btn-outline page-back-link" asp-page="/Index">← Zpět do administrace</a>

<section class="section admin-section">
    <div class="wrap">
        <div class="admin-head">
            <h1>Newsletter odběratelé</h1>
            <a class="btn btn-outline" asp-page="/Newsletter/Index" asp-page-handler="Export">Export CSV</a>
        </div>

        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>E-mail</th>
                    <th>Breathwork</th>
                    <th>Koně</th>
                    <th>Veterina</th>
                    <th>Aktivní</th>
                    <th>Vytvořeno</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var subscriber in Model.Subscribers)
                {
                    <tr>
                        <td>@subscriber.Email</td>
                        <td><partial name="_BoolIcon" model="subscriber.PrefBreathwork" /></td>
                        <td><partial name="_BoolIcon" model="subscriber.PrefHorses" /></td>
                        <td><partial name="_BoolIcon" model="subscriber.PrefVeterinary" /></td>
                        <td><partial name="_BoolIcon" model="subscriber.IsSubscribed" /></td>
                        <td>@subscriber.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

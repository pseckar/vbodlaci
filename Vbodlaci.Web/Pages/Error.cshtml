@page
@model ErrorModel
@{
    ViewData["Title"] = "Chyba";
}

<section class="section section-cream">
    <div class="wrap">
        <div class="prose">
            <h1>Něco se pokazilo</h1>
            <p>Při zpracování požadavku došlo k chybě. Zkus to prosím znovu, nebo se vrať na hlavní stránku.</p>

            @if (Model.ShowRequestId)
            {
                <p>
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <a class="btn btn-moss" asp-page="/Index">Zpět na hlavní stránku</a>
        </div>
    </div>
</section>

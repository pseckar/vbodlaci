@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using Vbodlaci.Web.Application.Configuration
@inject IOptions<SiteOptions> SiteOptionsAccessor
@inject SignInManager<IdentityUser> SignInManager
@{
    var site = SiteOptionsAccessor.Value;
    var flashMessage = TempData["FlashMessage"] as string;
    var flashType = TempData["FlashType"] as string ?? "info";
    var isSignedIn = SignInManager.IsSignedIn(User);
    var area = ViewContext.RouteData.Values["area"] as string;
    var isAdminUi = string.Equals(area, "Admin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(area, "Identity", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - V bodláčí</title>
    <script>document.documentElement.classList.add("js");</script>
    @if (isAdminUi)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isAdminUi)
    {
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    }
</head>
<body>
<partial name="_ThistleDefs" />
<div class="shell">
    @if (isSignedIn)
    {
        <header class="topbar">
            <span class="brand brand-admin">Administrátorská zóna</span>
            <div class="topbar-actions">
                <partial name="_LoginPartial" />
            </div>
        </header>
    }

    @if (!string.IsNullOrWhiteSpace(flashMessage))
    {
        <div class="flash flash-@flashType">@flashMessage</div>
    }

    <main class="main-content" role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        @if (!isAdminUi)
        {
            <partial name="_Thistle" model='new ThistleMark("footer-thistle")' />
        }
        <div class="wrap">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">
                        <partial name="_Thistle" model='new ThistleMark("thistle-mini footer-brand-mark", "--t-bloom:#c9b3dd; --t-fill:rgba(176,219,114,0.15); --t-leaf:rgba(176,219,114,0.4)")' />
                        V bodláčí
                    </div>
                    <p class="footer-tag">Dech, koně a laskavá veterinární péče v jednom místě. Hlinsko a okolí.</p>
                </div>
                <div>
                    <h4>Rozcestník</h4>
                    <ul>
                        <li><a asp-page="/Services/Breathwork">Breathwork v bodláčí</a></li>
                        <li><a asp-page="/Services/Horses">Koně v bodláčí</a></li>
                        <li><a asp-page="/Services/Veterinary">Veterina v bodláčí</a></li>
                        <li><a asp-page="/Index" asp-fragment="kurzy">Nejbližší kurzy</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Sleduj mě</h4>
                    <ul>
                        <li><a href="@site.FacebookUrl" target="_blank" rel="noopener">Facebook</a></li>
                        <li><a href="@site.InstagramUrl" target="_blank" rel="noopener">Instagram</a></li>
                        <li><a asp-page="/Index" asp-fragment="kontakt">Kontakt</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>
                    &copy; @DateTime.Now.Year V bodláčí
                    &middot; <a asp-page="/Legal/PersonalData">Zásady zpracování osobních údajů</a>
                    &middot; <a asp-page="/Legal/Cookies">Zásady cookies</a>
                    &middot; <a asp-page="/Legal/CourseTerms">Podmínky kurzu</a>
                </span>
                @if (!isSignedIn)
                {
                    <a class="footer-admin" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Admin">Admin přihlášení</a>
                }
            </div>
        </div>
    </footer>
</div>

<button id="backToTop" type="button" class="back-to-top" aria-label="Jít nahoru">&#8593;</button>

@if (isAdminUi)
{
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
}
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

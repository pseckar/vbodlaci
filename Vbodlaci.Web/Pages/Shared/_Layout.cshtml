@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using Vbodlaci.Web.Application.Configuration
@inject IOptions<SiteOptions> SiteOptionsAccessor
@inject SignInManager<IdentityUser> SignInManager
@{
    var site = SiteOptionsAccessor.Value;
    var flashMessage = TempData["FlashMessage"] as string;
    var flashType = TempData["FlashType"] as string ?? "info";
    var isSignedIn = SignInManager.IsSignedIn(User);
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - V bodláčí</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vbodlaci.Web.styles.css" asp-append-version="true" />
</head>
<body>
<div class="shell">
    @if (isSignedIn)
    {
        <header class="topbar">
            <span class="brand brand-admin">Administrátorská zóna</span>
            <div class="topbar-actions">
                <partial name="_LoginPartial" />
            </div>
        </header>
    }

    @if (!string.IsNullOrWhiteSpace(flashMessage))
    {
        <div class="flash flash-@flashType">@flashMessage</div>
    }

    <main class="main-content" role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-main">
            <div class="footer-brand">V bodláčí</div>
            @if (!isSignedIn)
            {
                <a class="admin-link footer-admin-link" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Admin">Admin přihlášení</a>
            }
        </div>
        <div class="footer-links">
            <a href="@site.FacebookUrl" target="_blank" rel="noopener">Facebook</a>
            <a href="@site.InstagramUrl" target="_blank" rel="noopener">Instagram</a>
            <a asp-page="/Legal/PersonalData">Zásady zpracování osobních údajů</a>
            <a asp-page="/Legal/Cookies">Zásady cookies</a>
            <a asp-page="/Legal/CourseTerms">Podmínky kurzu</a>
        </div>
    </footer>
</div>

<button id="backToTop" type="button" class="back-to-top" aria-label="Jít nahoru">Jít nahoru</button>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

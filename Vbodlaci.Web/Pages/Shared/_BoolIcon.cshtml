@model bool

@if (Model)
{
    <span class="bool-icon bool-yes" role="img" aria-label="Ano">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" /></svg>
    </span>
}
else
{
    <span class="bool-icon bool-no" role="img" aria-label="Ne">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4.5 4.5 11.5 11.5 M11.5 4.5 4.5 11.5" /></svg>
    </span>
}

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<div class="auth-actions">
    @if (SignInManager.IsSignedIn(User))
    {
        <span class="auth-user">Přihlášen: @User.Identity?.Name</span>
        <a asp-area="Identity" asp-page="/Account/Manage/Index">Profil</a>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="link-button">Odhlásit</button>
        </form>
    }
    else
    {
        <a asp-area="Identity" asp-page="/Account/Login">Admin přihlášení</a>
    }
</div>

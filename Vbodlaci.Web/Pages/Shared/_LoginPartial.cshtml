@using System
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    var area = ViewContext.RouteData.Values["area"] as string;
    var isInAdmin = string.Equals(area, "Admin", StringComparison.OrdinalIgnoreCase);

    if (isInAdmin)
    {
        <a class="admin-link" asp-area="" asp-page="/Index">Zpět na web</a>
    }
    else
    {
        <a class="admin-link" asp-area="Admin" asp-page="/Index">Administrace</a>
    }

    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
        <button type="submit" class="link-button">Odhlásit</button>
    </form>
}

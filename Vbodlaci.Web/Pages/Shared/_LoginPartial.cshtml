@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <a class="admin-link" asp-area="Admin" asp-page="/Index">Administrace</a>
    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
        <button type="submit" class="link-button">Odhlásit</button>
    </form>
}
else
{
    <a class="admin-link" asp-area="Identity" asp-page="/Account/Login">Admin přihlášení</a>
}

@using Vbodlaci.Web.Application.Courses
@model IReadOnlyList<CourseListItem>
@{
    var source = ViewData["CourseSource"] as string;
    source = string.IsNullOrWhiteSpace(source) ? null : source;
}

<div class="course-grid" role="list">
    @foreach (var course in Model)
    {
        <article class="course-card" role="listitem" data-course-type="@(course.Type == Vbodlaci.Web.Domain.Courses.CourseType.Breathwork ? "breathwork" : "kone")">
            <img class="course-card-image" src="@course.ThumbnailImageUrl" alt="" loading="lazy" />
            <div class="course-card-body">
                <div class="course-meta">
                    <span class="course-type">@(course.Type == Vbodlaci.Web.Domain.Courses.CourseType.Breathwork ? "Breathwork" : "Koně")</span>
                    <span>@course.CourseDate.ToString("dd.MM.yyyy")</span>
                </div>
                <h3>@course.Title</h3>
                <div class="course-place">@course.CityOrArea</div>
                <p>@course.ShortDescription</p>
                <a class="button button-primary" asp-page="/Courses/Detail" asp-route-slug="@course.Slug" asp-route-from="@source">Detail kurzu</a>
            </div>
        </article>
    }
</div>

@page "/kurzy/{slug}"
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Vbodlaci.Web.Domain.Courses
@model Vbodlaci.Web.Pages.Courses.DetailModel
@{
    ViewData["Title"] = Model.Course?.Title ?? "Detail kurzu";
    var relatedViewData = new ViewDataDictionary(ViewData)
    {
        ["CourseSource"] = string.IsNullOrWhiteSpace(Model.SourceContext) ? null : Model.SourceContext
    };
}

@if (Model.Course is null)
{
    <section class="section section-light">
        <div class="container py-5">
            <h1>Kurz nebyl nalezen</h1>
        </div>
    </section>
    return;
}

@{
    var servicePage = Model.Course.Type == CourseType.Breathwork ? "/Services/Breathwork" : "/Services/Horses";
    var serviceCta = Model.Course.Type == CourseType.Breathwork ? "Více o breathworku" : "Více o koních";
}

<a class="button button-secondary page-back-link" asp-page="@Model.BackLinkPage">@Model.BackLinkText</a>

<section class="image-hero image-hero-small">
    <img src="@Model.Course.ImageUrl" alt="" />
    <div class="image-hero-overlay">
        <div class="container">
            <div class="status-badge status-@Model.Course.Status.ToString().ToLowerInvariant()">
                @switch (Model.Course.Status)
                {
                    case CourseStatus.Published:
                        @:Vypsaný kurz
                        break;
                    case CourseStatus.Canceled:
                        @:Zrušený kurz
                        break;
                    default:
                        @:Koncept
                        break;
                }
            </div>
            <h1>@Model.Course.Title</h1>
        </div>
    </div>
</section>

@if (Model.Course.IsFullDescriptionVisible)
{
    <section class="section section-light">
        <div class="container py-5">
            <h2>O kurzu</h2>
            <p>@Model.Course.FullDescription</p>
            <a class="button button-primary" asp-page="@servicePage">@serviceCta</a>
        </div>
    </section>
}

<section class="section section-green">
    <div class="container py-5">
        <div class="split-content">
            <div class="panel-card">
                <h2>Základní informace</h2>
                <table class="info-table">
                    <tbody>
                    <tr><th>Datum</th><td>@Model.Course.CourseDate.ToString("dd.MM.yyyy")</td></tr>
                    <tr><th>Čas</th><td>@Model.Course.TimeText</td></tr>
                    <tr><th>Místo</th><td>@Model.Course.CityOrArea</td></tr>
                    <tr><th>Cena</th><td>@Model.Course.PriceText</td></tr>
                    @if (Model.Course.CapacityInfo.HasValue)
                    {
                        <tr><th>Kapacita</th><td>@Model.Course.CapacityInfo</td></tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.Course.IsWhatToExpectVisible)
            {
                <div class="panel-card">
                    <h2>Co tě čeká</h2>
                    <p>@Model.Course.WhatToExpect</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="section section-gold" id="registrace">
    <div class="container py-5">
        <h2>Přihlášení na kurz</h2>

        @if (Model.IsCanceled)
        {
            <p class="field-error">Tento kurz je zrušený. Přihlášení je uzavřené.</p>
        }
        else
        {
            <form method="post" asp-page="/Courses/Detail" asp-route-slug="@Model.Course.Slug" class="form-grid registration-form">
                <input type="hidden" name="from" value="@Model.SourceContext" />

                <label class="hidden-honeypot" asp-for="Registration.Honeypot">Nechte prázdné</label>
                <input class="hidden-honeypot" asp-for="Registration.Honeypot" autocomplete="off" />

                <input asp-for="Registration.FullName" placeholder="Jméno" />
                <span asp-validation-for="Registration.FullName" class="field-error"></span>

                <input asp-for="Registration.Email" placeholder="E-mail" />
                <span asp-validation-for="Registration.Email" class="field-error"></span>

                <textarea asp-for="Registration.Note" placeholder="Poznámka"></textarea>
                <span asp-validation-for="Registration.Note" class="field-error"></span>

                <label class="checkbox-row">
                    <input asp-for="Registration.TermsConsent" />
                    Souhlasím s podmínkami kurzu.
                </label>
                <span asp-validation-for="Registration.TermsConsent" class="field-error"></span>

                <button type="submit" class="button button-dark">Závazně přihlásit</button>
            </form>
        }
    </div>
</section>

<section class="section section-pale">
    <div class="container py-5">
        <h2>Další termíny</h2>
        @if (Model.RelatedCourses.Count == 0)
        {
            <p class="muted">Další termíny zatím nejsou vypsané.</p>
        }
        else
        {
            <partial name="_CourseCards" model="Model.RelatedCourses" view-data="relatedViewData" />
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!ViewData.ModelState.IsValid)
    {
        <script>
            (() => {
                const section = document.getElementById("registrace");
                if (section) {
                    section.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            })();
        </script>
    }
}

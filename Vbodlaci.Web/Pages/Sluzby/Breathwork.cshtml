@page "/breathwork-v-bodlaci"
@model Vbodlaci.Web.Pages.Sluzby.BreathworkModel
@{
    ViewData["Title"] = "Breathwork v bodláčí";
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
}

<section class="section hero">
    <a class="button button-secondary" asp-page="/Index">← Zpět na hlavní stránku</a>
    <h1>Breathwork v bodláčí</h1>
    <p>Dech není výkon. Je to cesta, jak být víc v těle, ve vztahu k sobě a ve větším klidu.</p>
</section>

<section class="section grid-2">
    <article class="section"><h2>Pro koho je breathwork</h2><p>Pro každého, kdo chce zpomalit, snížit napětí a vytvořit si větší kapacitu pro běžný život.</p></article>
    <article class="section"><h2>Co může přinést</h2><p>Regulaci nervového systému, lepší kontakt se sebou a větší stabilitu.</p></article>
</section>

<section class="section">
    <h2>Jak setkání probíhá</h2>
    <div class="grid-3">
        <article class="section"><h3>1. Naladění</h3><p>Zklidnění a vytvoření bezpečného prostoru.</p></article>
        <article class="section"><h3>2. Dechová praxe</h3><p>Vedená práce s dechem s respektem k tvému tempu.</p></article>
        <article class="section"><h3>3. Integrace</h3><p>Doznění, ukotvení a prostor pro otázky.</p></article>
    </div>
</section>

<section class="section">
    <h2>Nejbližší breathwork termíny</h2>
    @if (Model.Courses.Count == 0)
    {
        <p class="muted">Aktuálně nejsou vypsané žádné breathwork termíny.</p>
    }
    else
    {
        <partial name="_CourseCards" model="Model.Courses" />
    }
</section>

<section class="section"><h2>Časté otázky</h2><div class="grid-2"><article class="section"><h3>Musím mít zkušenost?</h3><p>Nemusíš. I první zkušenost může být jemná a bezpečná.</p></article><article class="section"><h3>Je to náročné?</h3><p>Tempo je vedené citlivě a respektuje tvé možnosti.</p></article></div></section>

<section class="section" id="kontakt-breathwork">
    <h2>Kontakt k breathwork</h2>
    <form method="post" asp-page="/Akce/Kontakt" class="form-grid">
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <input type="hidden" name="SourcePage" value="breathwork" />
        <label class="hidden-honeypot" for="bw-contact-honeypot">Nechte prázdné</label>
        <input class="hidden-honeypot" id="bw-contact-honeypot" type="text" name="Honeypot" autocomplete="off" />
        <input type="text" name="FullName" placeholder="Jméno" required maxlength="120" />
        <input type="email" name="Email" placeholder="E-mail" required maxlength="180" />
        <textarea name="Message" placeholder="Dotaz" required maxlength="2500"></textarea>
        <button class="button button-primary" type="submit">Poslat dotaz</button>
    </form>
</section>

<section class="section">
    <h2>Newsletter</h2>
    <form method="post" asp-page="/Akce/Newsletter" class="form-grid">
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <label class="hidden-honeypot" for="bw-news-honeypot">Nechte prázdné</label>
        <input class="hidden-honeypot" id="bw-news-honeypot" type="text" name="Honeypot" autocomplete="off" />
        <input type="email" name="Email" placeholder="E-mail" required maxlength="180" />
        <label class="checkbox-row"><input type="checkbox" name="PrefBreathwork" checked /> Breathwork</label>
        <label class="checkbox-row"><input type="checkbox" name="PrefHorses" /> Koně</label>
        <label class="checkbox-row"><input type="checkbox" name="PrefVeterinary" /> Veterina</label>
        <button class="button button-primary" type="submit">Přihlásit k odběru</button>
    </form>
</section>




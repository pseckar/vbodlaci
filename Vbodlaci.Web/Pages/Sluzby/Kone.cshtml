@page "/kone-v-bodlaci"
@model Vbodlaci.Web.Pages.Sluzby.KoneModel
@{
    ViewData["Title"] = "Koně v bodláčí";
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
}

<section class="section hero">
    <a class="button button-secondary" asp-page="/Index">← Zpět na hlavní stránku</a>
    <h1>Koně v bodláčí</h1>
    <p>Setkání s koňmi vytváří prostor pro vnímání hranic, autenticity a hlubší změnu.</p>
</section>

<section class="section grid-2">
    <article class="section"><h2>Pro koho je setkání vhodné</h2><p>Pro lidi, kteří chtějí porozumět svým vztahovým vzorcům a emocím.</p></article>
    <article class="section"><h2>Jak může pomoci</h2><p>Kůň dává okamžitou zpětnou vazbu a pomáhá vidět vlastní nastavení jasněji.</p></article>
</section>

<section class="section">
    <h2>Jak setkání probíhá</h2>
    <div class="grid-3">
        <article class="section"><h3>1. Úvod</h3><p>Domluva rámce, záměru a bezpečnosti.</p></article>
        <article class="section"><h3>2. Kontakt s koněm</h3><p>Praktická facilitovaná práce na zemi.</p></article>
        <article class="section"><h3>3. Integrace</h3><p>Reflexe prožitku a přenos do běžného života.</p></article>
    </div>
</section>

<section class="section">
    <h2>Nejbližší termíny s koňmi</h2>
    @if (Model.Courses.Count == 0)
    {
        <p class="muted">Aktuálně nejsou vypsané žádné termíny.</p>
    }
    else
    {
        <partial name="_CourseCards" model="Model.Courses" />
    }
</section>

<section class="section"><h2>Časté otázky</h2><div class="grid-2"><article class="section"><h3>Musím umět jezdit?</h3><p>Ne. Práce probíhá ze země.</p></article><article class="section"><h3>Je to terapie?</h3><p>Nejde o terapii, ale o facilitované sebepoznávací setkání.</p></article></div></section>

<section class="section" id="kontakt-kone">
    <h2>Kontakt ke setkáním s koňmi</h2>
    <form method="post" asp-page="/Akce/Kontakt" class="form-grid">
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <input type="hidden" name="SourcePage" value="kone" />
        <label class="hidden-honeypot" for="kone-contact-honeypot">Nechte prázdné</label>
        <input class="hidden-honeypot" id="kone-contact-honeypot" type="text" name="Honeypot" autocomplete="off" />
        <input type="text" name="FullName" placeholder="Jméno" required maxlength="120" />
        <input type="email" name="Email" placeholder="E-mail" required maxlength="180" />
        <textarea name="Message" placeholder="Dotaz" required maxlength="2500"></textarea>
        <button class="button button-primary" type="submit">Poslat dotaz</button>
    </form>
</section>

<section class="section">
    <h2>Newsletter</h2>
    <form method="post" asp-page="/Akce/Newsletter" class="form-grid">
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <label class="hidden-honeypot" for="kone-news-honeypot">Nechte prázdné</label>
        <input class="hidden-honeypot" id="kone-news-honeypot" type="text" name="Honeypot" autocomplete="off" />
        <input type="email" name="Email" placeholder="E-mail" required maxlength="180" />
        <label class="checkbox-row"><input type="checkbox" name="PrefBreathwork" /> Breathwork</label>
        <label class="checkbox-row"><input type="checkbox" name="PrefKone" checked /> Koně</label>
        <label class="checkbox-row"><input type="checkbox" name="PrefVeterina" /> Veterina</label>
        <button class="button button-primary" type="submit">Přihlásit k odběru</button>
    </form>
</section>



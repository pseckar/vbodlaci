@page "/kone-v-bodlaci"
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model Vbodlaci.Web.Pages.Services.HorsesModel
@{
    ViewData["Title"] = "Koně v bodláčí";
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
    var courseCardsViewData = new ViewDataDictionary(ViewData)
    {
        ["CourseSource"] = "kone"
    };
}

<header class="hero hero-small" style="--photo-src:url('@SiteImages.HeroHorses')">
    <a class="btn btn-ghost-light page-back-link" asp-page="/Index">← Zpět na hlavní stránku</a>
    <div class="hero-inner">
        <div class="wrap">
            <h1>Koně v bodláčí</h1>
            <p class="hero-tagline">Setkání s koňmi pro vnímání hranic, autenticity a hlubší změnu.</p>
        </div>
    </div>
    <partial name="_Curve" model='new SectionCurve("var(--cream)", Hero: true)' />
</header>

<section class="section section-cream">
    <div class="wrap">
        <div class="section-head reveal" style="margin-bottom:0">
            <span class="kicker">pro koho</span>
            <h2>Pro koho je setkání vhodné</h2>
            <p class="lede">Pro lidi, kteří chtějí porozumět svým vztahovým vzorcům, emocím a kontaktu se sebou i okolím.</p>
        </div>
    </div>
</section>

<section class="section section-leaf">
    <div class="wrap">
        <div class="section-head reveal">
            <span class="kicker">krok za krokem</span>
            <h2>Jak setkání probíhá</h2>
        </div>
        <div class="step-grid">
            <article class="step-card reveal">
                <span class="step-num" aria-hidden="true">1</span>
                <h3>Úvod</h3>
                <p>Domluva rámce, záměru a bezpečnosti.</p>
            </article>
            <article class="step-card reveal reveal-d1">
                <span class="step-num" aria-hidden="true">2</span>
                <h3>Kontakt s koněm</h3>
                <p>Praktická facilitovaná práce na zemi.</p>
            </article>
            <article class="step-card reveal reveal-d2">
                <span class="step-num" aria-hidden="true">3</span>
                <h3>Integrace</h3>
                <p>Reflexe prožitku a přenos do běžného života.</p>
            </article>
        </div>
    </div>
</section>

<section class="section section-white">
    <div class="wrap">
        <div class="section-head reveal">
            <span class="kicker">přidej se</span>
            <h2>Termíny s koňmi</h2>
        </div>
        @if (Model.Courses.Count == 0)
        {
            <p class="muted">Aktuálně nejsou vypsané žádné termíny.</p>
        }
        else
        {
            <partial name="_CourseCards" model="Model.Courses" view-data="courseCardsViewData" />
        }
    </div>
</section>

<section class="section section-cream">
    <div class="wrap">
        <div class="section-head reveal">
            <span class="kicker">ptáš se</span>
            <h2>Časté otázky</h2>
        </div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>Musím umět jezdit?</summary>
                <p>Ne. Práce probíhá ze země.</p>
            </details>
            <details class="faq-item">
                <summary>Je to terapie?</summary>
                <p>Nejde o terapii, ale o facilitované sebepoznávací setkání.</p>
            </details>
        </div>
    </div>
</section>

<partial name="_ContactNewsletter" model='new ContactNewsletterViewModel
{
    SourcePage = "kone",
    HoneypotIdPrefix = "kone",
    ReturnUrl = returnUrl,
    SectionId = "kontakt-kone",
    ContactHeading = "Kontakt ke setkáním s koňmi",
    MessagePlaceholder = "Dotaz",
    ContactSubmitLabel = "Poslat dotaz",
    PrefHorsesChecked = true
}' />

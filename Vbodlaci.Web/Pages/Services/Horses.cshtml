@page "/kone-v-bodlaci"
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model Vbodlaci.Web.Pages.Services.HorsesModel
@{
    ViewData["Title"] = "Koně v bodláčí";
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
    const string heroImage = "/images/title-image.jpeg";
    var courseCardsViewData = new ViewDataDictionary(ViewData)
    {
        ["CourseSource"] = "kone"
    };
}

<a class="button button-secondary page-back-link" asp-page="/Index">← Zpět na hlavní stránku</a>

<section class="image-hero image-hero-small">
    <img src="@heroImage" alt="" />
    <div class="image-hero-overlay">
        <div class="container">
            <h1>Koně v bodláčí</h1>
            <p>Setkání s koňmi pro vnímání hranic, autenticity a hlubší změnu.</p>
        </div>
    </div>
</section>

<section class="section section-light">
    <div class="container py-5">
        <h2>Pro koho je setkání vhodné</h2>
        <p>Pro lidi, kteří chtějí porozumět svým vztahovým vzorcům, emocím a kontaktu se sebou i okolím.</p>
    </div>
</section>

<section class="section section-green">
    <div class="container py-5">
        <h2>Jak setkání probíhá</h2>
        <div class="step-grid">
            <article class="panel-card"><h3>1. Úvod</h3><p>Domluva rámce, záměru a bezpečnosti.</p></article>
            <article class="panel-card"><h3>2. Kontakt s koněm</h3><p>Praktická facilitovaná práce na zemi.</p></article>
            <article class="panel-card"><h3>3. Integrace</h3><p>Reflexe prožitku a přenos do běžného života.</p></article>
        </div>
    </div>
</section>

<section class="section section-pale">
    <div class="container py-5">
        <h2>Termíny s koňmi</h2>
        @if (Model.Courses.Count == 0)
        {
            <p class="muted">Aktuálně nejsou vypsané žádné termíny.</p>
        }
        else
        {
            <partial name="_CourseCards" model="Model.Courses" view-data="courseCardsViewData" />
        }
    </div>
</section>

<section class="section section-white">
    <div class="container py-5">
        <h2>Časté otázky</h2>
        <div class="faq-list">
            <details class="faq-item">
                <summary>Musím umět jezdit?</summary>
                <p>Ne. Práce probíhá ze země.</p>
            </details>
            <details class="faq-item">
                <summary>Je to terapie?</summary>
                <p>Nejde o terapii, ale o facilitované sebepoznávací setkání.</p>
            </details>
        </div>
    </div>
</section>

<section class="section section-gold" id="kontakt-kone">
    <div class="container py-5">
        <div class="split-content">
            <div>
                <h2>Kontakt ke setkáním s koňmi</h2>
                <form method="post" asp-page="/Actions/Contact" class="form-grid">
                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                    <input type="hidden" name="SourcePage" value="kone" />
                    <label class="hidden-honeypot" for="kone-contact-honeypot">Nechte prázdné</label>
                    <input class="hidden-honeypot" id="kone-contact-honeypot" type="text" name="Honeypot" autocomplete="off" />
                    <input type="text" name="FullName" placeholder="Jméno" required maxlength="120" />
                    <input type="email" name="Email" placeholder="E-mail" required maxlength="180" />
                    <textarea name="Message" placeholder="Dotaz" required maxlength="2500"></textarea>
                    <button class="button button-dark" type="submit">Poslat dotaz</button>
                </form>
            </div>
            <div>
                <h2>Newsletter</h2>
                <form method="post" asp-page="/Actions/Newsletter" class="form-grid">
                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                    <label class="hidden-honeypot" for="kone-news-honeypot">Nechte prázdné</label>
                    <input class="hidden-honeypot" id="kone-news-honeypot" type="text" name="Honeypot" autocomplete="off" />
                    <input type="email" name="Email" placeholder="E-mail" required maxlength="180" />
                    <label class="checkbox-row"><input type="checkbox" name="PrefBreathwork" /> Breathwork</label>
                    <label class="checkbox-row"><input type="checkbox" name="PrefHorses" checked /> Koně</label>
                    <label class="checkbox-row"><input type="checkbox" name="PrefVeterinary" /> Veterina</label>
                    <button class="button button-dark" type="submit">Přihlásit k odběru</button>
                </form>
            </div>
        </div>
    </div>
</section>

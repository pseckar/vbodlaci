@page "/breathwork-v-bodlaci"
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model Vbodlaci.Web.Pages.Services.BreathworkModel
@{
    ViewData["Title"] = "Breathwork v bodláčí";
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
    var courseCardsViewData = new ViewDataDictionary(ViewData)
    {
        ["CourseSource"] = "breathwork"
    };
}

<header class="hero hero-small" style="--photo-src:url('@SiteImages.HeroBreathwork')">
    <a class="btn btn-ghost-light page-back-link" asp-page="/Index">← Zpět na hlavní stránku</a>
    <div class="hero-inner">
        <div class="wrap">
            <h1>Breathwork v bodláčí</h1>
            <p class="hero-tagline">Dech jako cesta ke klidu, tělu a většímu kontaktu se sebou.</p>
        </div>
    </div>
    <partial name="_Curve" model='new SectionCurve("var(--cream)", Hero: true)' />
</header>

<section class="section section-cream">
    <div class="wrap">
        <div class="section-head reveal" style="margin-bottom:0">
            <span class="kicker">pro koho</span>
            <h2>Pro koho je breathwork</h2>
            <p class="lede">Pro každého, kdo chce zpomalit, snížit napětí a vytvořit si větší kapacitu pro běžný život.</p>
        </div>
    </div>
</section>

<section class="section section-leaf">
    <div class="wrap">
        <div class="section-head reveal">
            <span class="kicker">krok za krokem</span>
            <h2>Jak setkání probíhá</h2>
        </div>
        <div class="step-grid">
            <article class="step-card reveal">
                <span class="step-num" aria-hidden="true">1</span>
                <h3>Naladění</h3>
                <p>Zklidnění a vytvoření bezpečného prostoru.</p>
            </article>
            <article class="step-card reveal reveal-d1">
                <span class="step-num" aria-hidden="true">2</span>
                <h3>Dechová praxe</h3>
                <p>Vedená práce s dechem s respektem k tvému tempu.</p>
            </article>
            <article class="step-card reveal reveal-d2">
                <span class="step-num" aria-hidden="true">3</span>
                <h3>Integrace</h3>
                <p>Doznění, ukotvení a prostor pro otázky.</p>
            </article>
        </div>
    </div>
</section>

<section class="section section-white">
    <div class="wrap">
        <div class="section-head reveal">
            <span class="kicker">přidej se</span>
            <h2>Breathwork termíny</h2>
        </div>
        @if (Model.Courses.Count == 0)
        {
            <p class="muted">Aktuálně nejsou vypsané žádné breathwork termíny.</p>
        }
        else
        {
            <partial name="_CourseCards" model="Model.Courses" view-data="courseCardsViewData" />
        }
    </div>
</section>

<section class="section section-cream">
    <div class="wrap">
        <div class="section-head reveal">
            <span class="kicker">ptáš se</span>
            <h2>Časté otázky</h2>
        </div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>Musím mít zkušenost?</summary>
                <p>Nemusíš. I první zkušenost může být jemná a bezpečná.</p>
            </details>
            <details class="faq-item">
                <summary>Je to náročné?</summary>
                <p>Tempo je vedené citlivě a respektuje tvé možnosti.</p>
            </details>
        </div>
    </div>
</section>

<partial name="_ContactNewsletter" model='new ContactNewsletterViewModel
{
    SourcePage = "breathwork",
    HoneypotIdPrefix = "bw",
    ReturnUrl = returnUrl,
    SectionId = "kontakt-breathwork",
    ContactHeading = "Kontakt k breathwork",
    MessagePlaceholder = "Dotaz",
    ContactSubmitLabel = "Poslat dotaz",
    PrefBreathworkChecked = true
}' />

@page "/veterina-v-bodlaci"
@model Vbodlaci.Web.Pages.Services.VeterinaryModel
@{
    ViewData["Title"] = "Veterina v bodláčí";
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
}

<header class="hero hero-small" style="--photo-src:url('@SiteImages.HeroVeterinary')">
    <a class="btn btn-ghost-light page-back-link" asp-page="/Index">← Zpět na hlavní stránku</a>
    <div class="hero-inner">
        <div class="wrap">
            <h1>Veterina v bodláčí</h1>
            <p class="hero-tagline">Veterinární péče s odborností, lidskostí a citlivým přístupem.</p>
        </div>
    </div>
    <partial name="_Curve" model='new SectionCurve("var(--cream)", Hero: true)' />
</header>

<section class="section section-cream">
    <div class="wrap">
        <div class="section-head reveal">
            <span class="kicker">jak pomáhám</span>
            <h2>S čím se na mě můžeš obrátit</h2>
        </div>
        <div class="split-2">
            <div class="reveal">
                <h3>Co nabízím</h3>
                <p style="margin-top:0.6rem">Konzultace, domácí návštěvy a citlivou podporu v náročných situacích.</p>
            </div>
            <div class="reveal reveal-d1">
                <h3>Důstojné rozloučení doma</h3>
                <p style="margin-top:0.6rem">V případě eutanazie vytvářím klidný a respektující prostor pro zvíře i jeho blízké.</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-white">
    <div class="wrap">
        <div class="section-head reveal">
            <span class="kicker">ptáš se</span>
            <h2>Časté otázky</h2>
        </div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>Jak probíhá domácí návštěva?</summary>
                <p>Po zprávě nebo telefonátu spolu domluvíme termín i konkrétní průběh.</p>
            </details>
            <details class="faq-item">
                <summary>Jak rychle je možné se domluvit?</summary>
                <p>V akutních případech se snažím reagovat co nejdříve podle možností.</p>
            </details>
        </div>
    </div>
</section>

<partial name="_ContactNewsletter" model='new ContactNewsletterViewModel
{
    SourcePage = "veterina",
    HoneypotIdPrefix = "vet",
    ReturnUrl = returnUrl,
    SectionId = "kontakt-veterina",
    ContactHeading = "Kontakt k veterině",
    MessagePlaceholder = "Jak můžu pomoct?",
    ContactSubmitLabel = "Poslat dotaz",
    PrefVeterinaryChecked = true
}' />

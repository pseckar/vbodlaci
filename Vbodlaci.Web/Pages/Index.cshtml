@page "/"
@model Vbodlaci.Web.Pages.IndexModel
@{
    ViewData["Title"] = "V bodláčí";
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
}

<section class="section hero">
    <h1>V bodláčí</h1>
    <p>
        Místo, kde můžeš zpomalit, nadechnout se a vrátit se blíž k sobě.
        Najdeš tu kurzy, setkání a služby propojující práci s dechem, kontakt s koňmi a citlivou veterinární péči.
    </p>
</section>

<section class="section">
    <h2>Služby v bodláčí</h2>
    <div class="switcher">
        <a asp-page="/Sluzby/Breathwork">
            <div class="title">Breathwork v bodláčí</div>
            <div class="desc">Práce s dechem pro zklidnění, regulaci a lepší kontakt se sebou.</div>
        </a>
        <a asp-page="/Sluzby/Kone">
            <div class="title">Koně v bodláčí</div>
            <div class="desc">Facilitovaná setkání s koňmi pro sebepoznání a vztahovou transformaci.</div>
        </a>
        <a asp-page="/Sluzby/Veterina">
            <div class="title">Veterina v bodláčí</div>
            <div class="desc">Veterinární péče s lidským přístupem, konzultacemi a domácími návštěvami.</div>
        </a>
    </div>
</section>

<section class="section">
    <h2>Jedna osoba. Tři podoby práce.</h2>
    <p>
        Jsem Veronika Bodláková. Propojuji zkušenost veterinární lékařky s prací v oblasti sebepoznání,
        mindfulness a vztahu člověka se zvířetem i se sebou samým.
    </p>
</section>

<section class="section" id="kurzy">
    <h2>Nejbližší kurzy</h2>
    <div class="filter-row" data-course-filter-root data-selected-type="@Model.SelectedType">
        <button type="button" class="filter-pill @(Model.SelectedType == "all" ? "active" : null)" data-course-filter="all">Vše</button>
        <button type="button" class="filter-pill @(Model.SelectedType == "breathwork" ? "active" : null)" data-course-filter="breathwork">Breathwork</button>
        <button type="button" class="filter-pill @(Model.SelectedType == "kone" ? "active" : null)" data-course-filter="kone">Koně</button>
    </div>

    @if (Model.Courses.Count == 0)
    {
        <p class="muted">Aktuálně nejsou vypsané žádné kurzy.</p>
    }
    else
    {
        <partial name="_CourseCards" model="Model.Courses" />
        <p class="muted" data-course-filter-empty hidden>Pro zvolený filtr teď nejsou vypsané žádné kurzy.</p>
    }
</section>

<section class="section">
    <h2>Ohlasy</h2>
    <div class="grid-3">
        <article class="section">
            <p>"Jemné a přitom silné vedení. Odcházela jsem klidnější a víc ukotvená."</p>
            <div class="muted">Lenka</div>
        </article>
        <article class="section">
            <p>"Setkání s koňmi mi ukázalo věci, které jsem dlouho neviděl."</p>
            <div class="muted">Ondřej</div>
        </article>
        <article class="section">
            <p>"Důstojné rozloučení s naším pejskem doma pro nás znamenalo opravdu hodně."</p>
            <div class="muted">Martina</div>
        </article>
    </div>
</section>

<section class="section" id="kontakt">
    <h2>Kontakt</h2>
    <p>Pro dotaz nebo individuální domluvu mi napiš.</p>
    <form method="post" asp-page="/Akce/Kontakt" class="form-grid">
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <input type="hidden" name="SourcePage" value="home" />
        <label class="hidden-honeypot" for="home-contact-honeypot">Nechte prázdné</label>
        <input class="hidden-honeypot" id="home-contact-honeypot" type="text" name="Honeypot" autocomplete="off" />

        <input type="text" name="FullName" placeholder="Jméno" required maxlength="120" />
        <input type="email" name="Email" placeholder="E-mail" required maxlength="180" />
        <textarea name="Message" placeholder="Zpráva" required maxlength="2500"></textarea>
        <button class="button button-primary" type="submit">Odeslat zprávu</button>
    </form>
</section>

<section class="section" id="newsletter">
    <h2>Newsletter</h2>
    <p>Přihlas se a pošlu ti nové termíny kurzů.</p>
    <form method="post" asp-page="/Akce/Newsletter" class="form-grid">
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <label class="hidden-honeypot" for="home-news-honeypot">Nechte prázdné</label>
        <input class="hidden-honeypot" id="home-news-honeypot" type="text" name="Honeypot" autocomplete="off" />

        <input type="email" name="Email" placeholder="E-mail" required maxlength="180" />
        <label class="checkbox-row"><input type="checkbox" name="PrefBreathwork" checked /> Breathwork</label>
        <label class="checkbox-row"><input type="checkbox" name="PrefHorses" checked /> Koně</label>
        <label class="checkbox-row"><input type="checkbox" name="PrefVeterinary" /> Veterina</label>
        <button class="button button-primary" type="submit">Přihlásit k odběru</button>
    </form>
</section>




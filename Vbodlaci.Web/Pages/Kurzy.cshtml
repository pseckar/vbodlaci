@page "/kurzy"
@model Vbodlaci.Web.Pages.KurzyModel
@{
    ViewData["Title"] = "Kurzy";
}

<section class="hero-card">
    <h1>Aktuálně otevřené kurzy</h1>
    <p>
        Zobrazují se pouze publikované kurzy. Přihlášky návštěvníků budou doplněny v další fázi,
        teď je cílem přehled nabídky a administrace termínů.
    </p>
</section>

@if (Model.Courses.Count == 0)
{
    <section class="content-card">
        <h2>Momentálně nejsou vypsány žádné kurzy</h2>
        <p>Nové termíny se připravují. Vrať se prosím později.</p>
    </section>
}
else
{
    <section class="section-grid">
        @foreach (var course in Model.Courses)
        {
            <article class="content-card">
                <h2>@course.Title</h2>
                <p>@course.ShortDescription</p>
                <p class="small-text">
                    Start: <strong>@course.StartDate.ToString("dd.MM.yyyy")</strong> |
                    Kapacita: <strong>@course.Capacity</strong>
                </p>
                <p>@course.Description</p>
            </article>
        }
    </section>
}

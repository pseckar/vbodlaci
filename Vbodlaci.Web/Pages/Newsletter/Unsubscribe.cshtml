@page "/newsletter/odhlaseni/{token}"
@model Vbodlaci.Web.Pages.Newsletter.UnsubscribeModel
@{
    ViewData["Title"] = "Odhlášení z newsletteru";
}

<section class="section section-cream">
    <div class="wrap">
        <div class="prose">
            <h1>Odhlášení z newsletteru</h1>
            <p>@Model.Message</p>
            <a class="btn btn-moss" asp-page="/Index">Zpět na hlavní stránku</a>
        </div>
    </div>
</section>
